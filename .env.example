# 1. Primary LLM (Free Instant Tier) -> https://console.groq.com
GROQ_API_KEY="gsk_..."

# 2. Secondary LLM (Free Google AI Studio Key) -> https://aistudio.google.com
GEMINI_API_KEY="AIzaSy..."

# 3. Optional Search Enhancer (Free 1,000 searches/mo) -> https://tavily.com
TAVILY_API_KEY="tvly-..."

# 4. Point Next.js to the Backend (Local Daemon, Cloudflare Tunnel, or Cloud Backend)
# For Local Dev: "http://127.0.0.1:8000"
# For Vercel Production: "https://your-tunnel.trycloudflare.com" or "https://api.yourdomain.com"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
BACKEND_URL="http://127.0.0.1:8000"

# -------------------------------------------------------------
# Optional LiveKit & Voice Synthesis Cloud Credentials
# -------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
ELEVEN_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key
