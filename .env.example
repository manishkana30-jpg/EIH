# Point Next.js to the Keyless Backend Daemon
# Local Dev: "http://127.0.0.1:8000"
# Production: "https://your-tunnel.trycloudflare.com" or "https://api.yourdomain.com"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
BACKEND_URL="http://127.0.0.1:8000"

# ==============================================================================
# Optional Cloud Provider Fallbacks (Only needed if local daemon is unreachable)
# ==============================================================================
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# ==============================================================================
# Optional Real-Time WebRTC Audio (LiveKit)
# ==============================================================================
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""
# NEXT_PUBLIC_LIVEKIT_URL=""

# ==============================================================================
# Optional Daemon & Telemetry Settings
# ==============================================================================
# CORS_ORIGIN=""
# ENV="development"
# NEXT_PUBLIC_APP_VERSION="1.2.0"
